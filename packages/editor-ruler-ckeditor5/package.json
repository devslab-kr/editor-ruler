{
  "name": "@devslab/editor-ruler-ckeditor5",
  "version": "1.0.1",
  "description": "CKEditor 5 plugin for @devslab/editor-ruler — a Word-like horizontal ruler with margins, first-line indent, and guide lines.",
  "license": "Apache-2.0",
  "author": "devslab",
  "homepage": "https://devslab-kr.github.io/editor-ruler/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devslab-kr/editor-ruler.git",
    "directory": "packages/editor-ruler-ckeditor5"
  },
  "bugs": "https://github.com/devslab-kr/editor-ruler/issues",
  "keywords": [
    "ckeditor5",
    "ckeditor",
    "ckeditor5-plugin",
    "ruler",
    "wysiwyg",
    "indent",
    "margin",
    "ckeditor-ruler",
    "ckeditor5-ruler",
    "horizontal-ruler",
    "editor-ruler"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@devslab/editor-ruler": "workspace:^"
  },
  "peerDependencies": {
    "ckeditor5": ">=42.0.0"
  },
  "devDependencies": {
    "ckeditor5": "^48.4.0"
  }
}
