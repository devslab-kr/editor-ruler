{
  "name": "@devslab/editor-ruler",
  "version": "0.13.0",
  "description": "A Word-like horizontal ruler for web rich-text editors: margins, first-line indent, drag handles. Editor-agnostic core.",
  "license": "Apache-2.0",
  "author": "devslab",
  "homepage": "https://devslab-kr.github.io/editor-ruler/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devslab-kr/editor-ruler.git",
    "directory": "packages/editor-ruler"
  },
  "bugs": "https://github.com/devslab-kr/editor-ruler/issues",
  "keywords": [
    "ruler",
    "wysiwyg",
    "editor",
    "indent",
    "margin",
    "contenteditable",
    "rich-text",
    "editor-ruler",
    "horizontal-ruler",
    "wysiwyg-ruler",
    "word-like",
    "first-line-indent",
    "guides"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
