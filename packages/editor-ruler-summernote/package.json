{
  "name": "@devslab/editor-ruler-summernote",
  "version": "1.1.0",
  "description": "Summernote adapter for @devslab/editor-ruler — a Word-like horizontal ruler plugin.",
  "license": "Apache-2.0",
  "author": "devslab",
  "homepage": "https://devslab-kr.github.io/editor-ruler/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devslab-kr/editor-ruler.git",
    "directory": "packages/editor-ruler-summernote"
  },
  "bugs": "https://github.com/devslab-kr/editor-ruler/issues",
  "keywords": [
    "summernote",
    "summernote-plugin",
    "summernote-ruler",
    "ruler",
    "wysiwyg",
    "plugin",
    "indent",
    "margin",
    "horizontal-ruler",
    "editor-ruler"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@devslab/editor-ruler": "workspace:^"
  },
  "peerDependencies": {
    "summernote": ">=0.8.0"
  },
  "peerDependenciesMeta": {
    "summernote": {
      "optional": true
    }
  }
}
