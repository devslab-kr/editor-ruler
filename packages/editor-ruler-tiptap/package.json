{
  "name": "@devslab/editor-ruler-tiptap",
  "version": "1.0.0",
  "description": "Tiptap extension for @devslab/editor-ruler — a Word-like horizontal ruler with margins, first-line indent, and guide lines.",
  "license": "Apache-2.0",
  "author": "devslab",
  "homepage": "https://devslab-kr.github.io/editor-ruler/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devslab-kr/editor-ruler.git",
    "directory": "packages/editor-ruler-tiptap"
  },
  "bugs": "https://github.com/devslab-kr/editor-ruler/issues",
  "keywords": [
    "tiptap",
    "tiptap-extension",
    "prosemirror",
    "ruler",
    "wysiwyg",
    "indent",
    "margin",
    "tiptap-ruler",
    "horizontal-ruler",
    "editor-ruler",
    "tiptap-v3"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@devslab/editor-ruler": "workspace:^"
  },
  "peerDependencies": {
    "@tiptap/core": ">=2.0.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.6.5",
    "@tiptap/pm": "^3.6.5",
    "@tiptap/starter-kit": "^3.6.5"
  }
}
